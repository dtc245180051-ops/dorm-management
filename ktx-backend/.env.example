# ==============================================================================
# KTX Management Backend - Environment Variables Template
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế của bạn.
# TUYỆT ĐỐI KHÔNG COMMIT TỆP .env VÀO GIT REPOSITORY!
# ==============================================================================

# Google Gemini AI API Key (Lấy tại Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Chuỗi kết nối CSDL MySQL (URL kết nối chuẩn qua PyMySQL)
DATABASE_URL=mysql+pymysql://root:12345678@localhost:3306/dorm_management

# Cấu hình bảo mật JWT Token
SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
