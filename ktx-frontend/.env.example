# ==============================================================================
# KTX Management Frontend - Environment Variables Template
# Hướng dẫn: Sao chép tệp này thành .env.local và điền các giá trị thực tế của bạn.
# TUYỆT ĐỐI KHÔNG COMMIT TỆP .env HOẶC .env.local VÀO GIT REPOSITORY!
# ==============================================================================

# Google Gemini AI API Key (Dùng cho Chatbot tư vấn và gợi ý xếp phòng ở Client)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# Cấu hình tài khoản ngân hàng nhận tiền KTX (VietQR)
VITE_BANK_ID=TPBank
VITE_ACCOUNT_NO=20020813520
VITE_ACCOUNT_NAME=BAN QUAN LY KTX ICTU
